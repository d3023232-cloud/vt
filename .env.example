# Токен бота, полученный от @BotFather
BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Telegram ID администратора (доступ к /admin)
ADMIN_ID=123456789

# Путь к файлу базы данных SQLite
DATABASE_PATH=vape_tycoon.db

# ID канала, куда публикуются аукционы (формат -100xxxxxxxxxx)
AUCTION_CHANNEL_ID=-1001234567890

# Username канала для отображения (без @)
AUCTION_CHANNEL_USERNAME=vape_auctions

# Сколько Паров даёт одна затяжка
PUFFS_PER_VAPOR=5

# Время регенерации бака в минутах
REGEN_TIME_MINUTES=30

# Минимальный процент износа при регенерации
WEAR_MIN_PERCENT=5

# Максимальный процент износа при регенерации
WEAR_MAX_PERCENT=30

# Максимальное количество подиков в инвентаре
MAX_VAPES_PER_USER=3

# Время между анонсом и стартом торгов (минуты)
AUCTION_ANNOUNCE_MINUTES=15

# Таймер ставки в секундах
BID_TIMER_SECONDS=30

# Перерыв между лотами в партии (минуты)
LOT_BREAK_MINUTES=15
